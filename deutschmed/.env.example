# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Powers the AI patient in /api/chat. Never expose to the browser.
# Leave empty to run the Anamnese simulator in offline demo mode.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=
