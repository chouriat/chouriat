# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# No AI key is needed here. Users add their OWN Gemini/OpenAI/Claude key in the
# app (stored only on their device). Never put an AI key in a NEXT_PUBLIC_ variable:
# those are bundled into the browser code and visible to every visitor.

# Google AdSense publisher ID (AdSense > Account > Account information). Leave empty to turn ads off.
# NEXT_PUBLIC_ values are baked in at build time, so redeploy after changing it.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Shown on /datenschutz. Use \n for line breaks in the operator, e.g. "Name\nStraße 1\n12345 Stadt".
NEXT_PUBLIC_SITE_OPERATOR=
NEXT_PUBLIC_CONTACT_EMAIL=
