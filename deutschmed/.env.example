# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# No AI key is needed here. Users add their OWN Gemini/OpenAI/Claude key in the
# app (stored only on their device). Never put an AI key in a NEXT_PUBLIC_ variable:
# those are bundled into the browser code and visible to every visitor.
