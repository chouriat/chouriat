# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The mobile app calls the deployed web app's API. No AI key belongs here:
# users add their own key inside the app (stored only on their device).
NEXT_PUBLIC_API_BASE_URL=https://chouriat-q4g8.vercel.app

# Google AdMob ad unit IDs (AdMob > Apps > Ad units). Leave empty to use Google's test ads.
# The AdMob *app* IDs go into the native projects instead: see README "Ads (AdMob)".
NEXT_PUBLIC_ADMOB_IOS_BANNER_ID=
NEXT_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=
NEXT_PUBLIC_ADMOB_ANDROID_BANNER_ID=
NEXT_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
