# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used later by the AI patient / evaluation routes. Never expose to the browser.
ANTHROPIC_API_KEY=

# Google AdSense publisher ID (AdSense > Account > Account information). Leave empty to turn ads off.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
