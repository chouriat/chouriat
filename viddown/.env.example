# ---- Server ----
PORT=3000
NODE_ENV=production
# Long random string used to sign download links. Generate with: openssl rand -hex 32
TOKEN_SECRET=change-me
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting)
TRUST_PROXY=1
RATE_LIMIT_PER_MIN=20
DOWNLOAD_LIMIT_PER_MIN=15
MAX_FILESIZE=700M
# Optional: Netscape-format cookies file, helps with Instagram/Facebook posts that need a login
# YTDLP_COOKIES=/app/cookies.txt

# ---- Site ----
SITE_URL=https://viddown.com
CONTACT_EMAIL=hello@viddown.com

# ---- Google AdSense ----
# Your publisher ID from AdSense > Account > Account information. Leave empty to show
# grey "Ad space" placeholders instead of real ads (useful during development).
ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Ad unit slot IDs from AdSense > Ads > By ad unit (Display ads, responsive)
ADSENSE_SLOT_HERO=0000000000
ADSENSE_SLOT_RESULT=0000000000
ADSENSE_SLOT_CONTENT=0000000000
ADSENSE_SLOT_FOOTER=0000000000
